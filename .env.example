# Salin ke .env lalu isi. Atau jalankan: ./scripts/gen-env.sh
POSTGRES_PASSWORD=ganti-password-db
# 32 byte base64 — JANGAN HILANG. Tanpa key ini semua password tersimpan tidak bisa dibuka.
ENCRYPTION_KEY=
# Minimal 32 karakter acak
SESSION_SECRET=
# true jika diakses lewat HTTPS
COOKIE_SECURE=false
APP_PORT=3000
# true = semua user wajib mengaktifkan 2FA login
REQUIRE_2FA=false
# Backup otomatis (folder ./backups)
BACKUP_INTERVAL_HOURS=24
BACKUP_KEEP_DAYS=14
TZ=Asia/Jakarta
